# Порт HTTP-сервера (по умолчанию 4817)
GITLIB_PORT=4817
# Папка с локальными данными: база, аватары, настройки (по умолчанию ./data)
GITLIB_DATA_DIR=./data
# Необязательно: токен GitHub (повышает лимит API с 60 до 5000 запросов/час)
GITHUB_TOKEN=
# Необязательно: OpenAI-совместимый эндпоинт для AI-анализа
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=
